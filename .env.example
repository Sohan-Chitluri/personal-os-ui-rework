# Copy to .env for local API development. This URL targets the Compose-only
# PostgreSQL container bound to 127.0.0.1:54329; it contains no production secret.
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://personal_os@127.0.0.1:54329/personal_os_dev
QUEUE_BACKEND=inline
ALLOW_SYNTHETIC_AUTH=true
DEV_AUTH_TOKEN=change-me-local-dev-token

# Raphael Assistant Backend (Hermes)
ASSISTANT_BACKEND=hermes
HERMES_ADAPTER=live
HERMES_BINARY_PATH=hermes
HERMES_SKILL_NAME=personal-os

# GitHub Integration (Public Mode or GitHub App OAuth)
GITHUB_PUBLIC_USERNAME=Sohan-Chitluri
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=


