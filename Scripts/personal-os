#!/usr/bin/env python3
"""
Personal OS - Terminal Widget
Main entry point for daily capture and automatic processing.
"""
import sys
import os
import json
import argparse
from pathlib import Path
from datetime import datetime

VAULT_ROOT = Path.home() / "projects" / "personal-os"
SKILLS_DIR = Path.home() / ".hermes" / "skills"
REGISTRY_PATH = VAULT_ROOT / "Scripts" / "skill_registry.json"
JOURNAL_DIR = VAULT_ROOT / "04-Personal" / "Journal"

def load_registry():
    with open(REGISTRY_PATH) as f:
        return json.load(f)

def ensure_journal_dir():
    JOURNAL_DIR.mkdir(parents=True, exist_ok=True)

def get_today_journal():
    ensure_journal_dir()
    today = datetime.now().strftime("%Y-%m-%d")
    return JOURNAL_DIR / f"{today}.md"

def append_to_journal(entry, source="Text"):
    """Append a raw entry to today's journal file."""
    journal_file = get_today_journal()
    
    # Create header if file doesn't exist
    if not journal_file.exists():
        header = "# " + datetime.now().strftime("%Y-%m-%d") + "\n\n"
        journal_file.write_text(header)
    
    timestamp = datetime.now().strftime("%H:%M")
    entry_text = "## " + timestamp + " - [Source: " + source + "]\n" + entry + "\n"
    
    with open(journal_file, 'a') as f:
        f.write(entry_text)
    
    print("✅ Logged to " + journal_file.name)
    return journal_file

def process_new_entry(journal_file, entry_text, dry_run=False):
    """Automatically process a new journal entry through the daily_stream skill."""
    print("🔄 Processing entry...")
    
    # Import and run the daily_stream processor
    sys.path.insert(0, str(Path.home() / ".hermes" / "skills" / "daily_stream"))
    try:
        from processor import DailyStreamProcessor
        
        processor = DailyStreamProcessor(VAULT_ROOT)
        
        # Extract knowledge from the new entry
        extractions = processor.extract_knowledge(entry_text)
        
        if not extractions:
            print("   No actionable information extracted.")
            return
        
        if dry_run:
            print("   [DRY RUN] Would apply " + str(len(extractions)) + " extractions:")
            for ext in extractions:
                print("     - " + ext['type'] + ": " + ext.get('project', 'N/A') + " - " + ext.get('description', '')[:60])
            return
        
        # Apply extractions
        all_changes = []
        for ext in extractions:
            changes = processor.apply_extraction(ext)
            all_changes.extend(changes)
        
        # Summary
        print("✅ Processing complete. Changes made:")
        for change in all_changes:
            print("   " + change)
            
    except Exception as e:
        print("⚠️ Processing error: " + str(e))

def capture_entry(args):
    """Capture a new entry to the daily stream and auto-process."""
    if args.entry:
        entry = " ".join(args.entry)
    else:
        # Interactive mode
        print("📝 Enter your capture (Ctrl+D to finish):")
        entry = sys.stdin.read().strip()
    
    if not entry:
        print("❌ No entry provided")
        return
    
    journal_file = append_to_journal(entry, args.source)
    print("📝 Captured: " + entry[:80] + ("..." if len(entry) > 80 else ""))
    
    # Automatic processing
    if not args.no_process:
        process_new_entry(journal_file, entry)

def show_today(args):
    """Show today's journal entries."""
    journal_file = get_today_journal()
    if journal_file.exists():
        print(journal_file.read_text())
    else:
        print("📭 No entries for today yet.")

def list_skills(args):
    """List available skills."""
    registry = load_registry()
    print("📚 Available Skills:")
    for name, info in registry["skills"].items():
        print("  • " + name + ": " + info["description"])
        print("    Triggers: " + ", ".join(info["triggers"][:5]) + "...")

def process_maintenance(args):
    """Maintenance processing tool."""
    print("🔧 Maintenance Processing")
    
    # Determine date range
    if args.date:
        target_date = args.date
    elif args.today:
        target_date = datetime.now().strftime("%Y-%m-%d")
    elif args.yesterday:
        from datetime import timedelta
        target_date = (datetime.now() - timedelta(days=1)).strftime("%Y-%m-%d")
    elif args.all:
        target_date = None  # Special case
    else:
        target_date = datetime.now().strftime("%Y-%m-%d")
    
    if target_date:
        journal_file = JOURNAL_DIR / (target_date + ".md")
        if journal_file.exists():
            content = journal_file.read_text()
            print("🔄 Processing " + target_date + "...")
            process_new_entry(journal_file, content, dry_run=args.dry_run)
        else:
            print("📭 No journal for " + target_date)
    else:
        print("🔄 Processing all journals... (not yet implemented)")

def main():
    parser = argparse.ArgumentParser(description="Personal OS Terminal Widget")
    subparsers = parser.add_subparsers(dest="command", help="Commands")
    
    # Capture command (primary workflow)
    cap_parser = subparsers.add_parser("capture", aliases=["c", "log"], help="Capture a new entry (auto-processes)")
    cap_parser.add_argument("entry", nargs="*", help="Entry text (if omitted, reads from stdin)")
    cap_parser.add_argument("--source", default="Text", choices=["Text", "Voice"], help="Input source")
    cap_parser.add_argument("--no-process", action="store_true", help="Skip automatic processing")
    
    # Today command
    today_parser = subparsers.add_parser("today", aliases=["t"], help="Show today's journal")
    
    # Skills command
    skills_parser = subparsers.add_parser("skills", aliases=["s"], help="List available skills")
    
    # Process command (maintenance only)
    proc_parser = subparsers.add_parser("process", aliases=["p"], help="Maintenance: reprocess journal entries")
    proc_parser.add_argument("--dry-run", action="store_true", help="Show what would be done without making changes")
    proc_parser.add_argument("--today", action="store_true", help="Process today's entries")
    proc_parser.add_argument("--yesterday", action="store_true", help="Process yesterday's entries")
    proc_parser.add_argument("--date", help="Process specific date (YYYY-MM-DD)")
    proc_parser.add_argument("--all", action="store_true", help="Process all journals")
    
    args = parser.parse_args()
    
    if args.command in ["capture", "c", "log"]:
        capture_entry(args)
    elif args.command in ["today", "t"]:
        show_today(args)
    elif args.command in ["skills", "s"]:
        list_skills(args)
    elif args.command in ["process", "p"]:
        process_maintenance(args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()